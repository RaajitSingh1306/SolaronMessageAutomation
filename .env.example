# Database Configuration
# Leave unset to use local SQLite (data/crm_data.db and ../Backend Dashboard/data/solar_analytics.db)
# For production (e.g. Supabase PostgreSQL):
# DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=
SOLAR_ANALYTICS_DB_PATH=../Backend Dashboard/data/solar_analytics.db
BACKEND_DASHBOARD_URL=http://127.0.0.1:8765

# Security API Key (optional for local dev, recommended in production)
API_KEY=

# WhatsApp Business / Omnichannel Messaging Provider API Keys
AISENSY_API_KEY=
FRESHWORKS_API_KEY=
FRESHWORKS_DOMAIN=
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=

# Automated CRM & Telemetry Sync
AUTO_SYNC_ENABLED=true
SYNC_INTERVAL_HOURS=24
CRM_SYNC_SCHEDULE_HOUR=6

# iSolarCloud Credentials
ISOLARCLOUD_USER=your_email_here
ISOLARCLOUD_PASSWORD=your_password_here
ISOLARCLOUD_URL=https://web3.isolarcloud.com.in/

# SuryaLog Credentials
SURYALOG_USER=your_username_here
SURYALOG_PASSWORD=your_password_here
SURYALOG_URL=https://cloud.suryalog.ae/

# Growatt API Credentials
GROWATT_USER=your_username_here
GROWATT_PASSWORD=your_password_here
GROWATT_SERVER_URL=https://server-api.growatt.com/

# Contact & Tariff Config
TEST_PHONE_NUMBER=
SUPPORT_PHONE=+919876543210
PRICE_PER_UNIT=14.0
CO2_KG_PER_KWH=0.82

# --- Message Templates ---
MSG_ACTIVE="Greetings From Solaron Homes Pvt Ltd,

Dear Sir/Madam,
Your solar plant generated {energy} units in the previous month {month_name} {year}
You have saved approximately ₹{savings}
Kindly ensure regular cleaning of your plant maximizes your savings.
If you want to buy cleaning equipment like telescopic poles, or have any other query, please reach out to us.

Thank You,
Team Solaron"

MSG_OFFLINE="Greetings From Solaron Homes Pvt Ltd,

Dear Sir/Madam,
your solar plant is offline. please check once physically...

If any queries, please connect with our team at {support_phone}

Team solaron,

सोलरॉन होम्स प्राइवेट लिमिटेड की ओर से आपको शुभकामनाएं

प्रिय महोदय/मैम,
आपका सोलर प्लांट ऑफ़लाइन है। कृपया एक बार भौतिक रूप से जाँच लें...

यदि कोई प्रश्न हैं, तो कृपया हमारी टीम को कॉल कीजिए {support_phone}

टीम सोलरॉन"

MSG_MONSOON="Greetings From Solaron Homes Pvt Ltd,

Dear Sir/Madam,
The monsoon season is going to start soon. We advise a thorough check of your solar plant's earthing and wiring.
Ensure there is no water accumulation near the electrical panels.

Thank You,
Team Solaron"